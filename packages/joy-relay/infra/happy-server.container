# podman quadlet — /etc/containers/systemd/happy-server.container
[Unit]
Description=happy-server (upstream relay, standalone/PGlite)
[Container]
Image=localhost/happy-server:latest
ContainerName=happy-server
EnvironmentFile=/etc/joy-relay/happy.env
Volume=happy-data:/data
PublishPort=127.0.0.1:3005:3005
[Service]
Restart=always
[Install]
WantedBy=multi-user.target
