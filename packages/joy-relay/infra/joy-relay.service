# systemd — /etc/systemd/system/joy-relay.service (bare on host: fast edit-restart)
# The STABLE relay: server.mjs on internal port 3105 (caddy :4997 → 3105).
# The relay is the only server — accounts, pairing, machines, push and the
# durable session plane all live in its PGlite store under JOY_RELAY_DATA_DIR.
[Unit]
Description=joy-relay (stable)
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/joy-relay
Environment=JOY_RELAY_PORT=3105
Environment=JOY_RELAY_DATA_DIR=/home/ubuntu/joy-relay-data/stable
# ~/joy-relay.env carries the secrets (never in this unit):
#   JOY_RELAY_ACCESS_KEY    perimeter key (gate.mjs); unset = open gate
#   JOY_RELAY_TOKEN_SECRET  bearer-token signing secret; unset = generated once
#                           into $JOY_RELAY_DATA_DIR/token.secret
#   JOY_RELAY_TOKEN_ISSUERS comma list of accepted token issuers, first mints
#                           (default "joy")
EnvironmentFile=-/home/ubuntu/joy-relay.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
