# systemd — /etc/systemd/system/joy-relay.service (bare on host: fast edit-restart)
[Unit]
Description=joy-relay (phase 0: passthrough to happy-server)
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/joy-relay
# Perimeter key (gate.mjs): create this file with JOY_RELAY_ACCESS_KEY=…
# to enforce the relay key; absent file = open (unset key = open gate).
EnvironmentFile=-/home/ubuntu/joy-relay.env
ExecStart=/usr/bin/node proxy.mjs
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
