# systemd — /etc/systemd/system/joy-relay-dev.service. The DEV relay: its own
# checkout (~/joy-relay-dev) on its own port and its own data dir, so
# iterating on relay code never touches the STABLE instance serving :4997.
[Unit]
Description=joy-relay (dev)
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/joy-relay-dev
Environment=JOY_RELAY_PORT=3106
Environment=JOY_RELAY_DATA_DIR=/home/ubuntu/joy-relay-data/dev
# Shares the perimeter key / token config with stable (see joy-relay.service).
EnvironmentFile=-/home/ubuntu/joy-relay.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
