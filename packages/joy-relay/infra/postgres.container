# podman quadlet — joy-relay's OWN database (phase 1+). Never shared with happy.
[Unit]
Description=postgres for joy-relay
[Container]
Image=docker.io/library/postgres:16
ContainerName=joy-relay-pg
Environment=POSTGRES_DB=joyrelay
EnvironmentFile=/etc/joy-relay/pg.env
Volume=joy-relay-pgdata:/var/lib/postgresql/data
PublishPort=127.0.0.1:5432:5432
[Service]
Restart=always
[Install]
WantedBy=multi-user.target
