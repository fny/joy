# happy-server, upstream-pristine, standalone mode (embedded PGlite).
# FAITHFUL root: real package.json/lockfile/.npmrc/workspace + scripts/ +
# patches/. The root postinstall matters: it applies the guarded patches
# (incl. fix-pglite-prisma-bytes — standalone NEEDS it) and builds
# @slopus/happy-wire's dist, which happy-server imports. Root has zero deps,
# so this stays light; workspace dirs not copied simply don't match.
FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY scripts ./scripts
COPY patches ./patches
COPY packages/happy-server ./packages/happy-server
COPY packages/happy-wire ./packages/happy-wire
# The real root already allowlists dep build scripts (pnpm.onlyBuiltDependencies).
RUN pnpm install --no-frozen-lockfile
WORKDIR /app/packages/happy-server
ENV DATA_DIR=/data
EXPOSE 3005
# migrate THEN serve: standalone's serve does NOT apply migrations (they're a
# separate subcommand), so a fresh data volume otherwise runs schemaless and
# every DB-touching route 500s. Migrations are tracked in _prisma_migrations —
# rerunning on start is idempotent.
CMD ["sh", "-c", "pnpm exec tsx sources/standalone.ts migrate && pnpm exec tsx sources/standalone.ts serve"]
