{
  "name": "@fny/joy-browser",
  "version": "0.3.0",
  "private": true,
  "description": "A browser extension (Chrome and Firefox) that ties a joy session to your browser",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node build.mjs",
    "lint:firefox": "node build.mjs && npx --yes web-ext@8 lint --source-dir dist/firefox",
    "sign:firefox": "node sign-firefox.mjs",
    "smoke:chrome": "node test/chrome-smoke.mjs",
    "smoke:firefox": "node test/firefox-smoke.mjs",
    "smoke:direct:chrome": "node test/direct-smoke-chrome.mjs",
    "smoke:direct:firefox": "node test/direct-smoke-firefox.mjs"
  },
  "engines": {
    "npm": ">=11.10.0"
  }
}
